{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(images|Irvin_Sivya_Resume_Portfolio\\.pdf)(.*)",
            "dest": "/static/$1$2",
            "headers": {
                "cache-control": "public, max-age=604800, stale-while-revalidate=86400"
            }
        },
        {
            "src": "/static/(css|js)/(.*)",
            "dest": "/static/$1/$2",
            "headers": {
                "cache-control": "public, max-age=3600, stale-while-revalidate=86400"
            }
        },
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ]
}
